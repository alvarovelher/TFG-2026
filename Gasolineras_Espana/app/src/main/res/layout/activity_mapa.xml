<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- ============================================== -->
    <!-- 1. BARRA SUPERIOR (LOGO + BÚSQUEDA / FILTROS)  -->
    <!-- ============================================== -->
    <!-- Estructura fuerte arriba para liberar peso visual del mapa -->
    <androidx.cardview.widget.CardView
        android:id="@+id/topBarFiltros"
        android:layout_width="0dp"
        android:layout_height="64dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:cardElevation="6dp"
        app:cardCornerRadius="0dp"
        app:cardBackgroundColor="@android:color/white">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="16dp">

            <!-- LOGO OFICIAL Fuel4Less -->
            <ImageView
                android:id="@+id/imgAppLogoTop"
                android:layout_width="113dp"
                android:layout_height="45dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="0dp"
                android:contentDescription="@string/cd_mapa_logo"
                android:src="@drawable/logo_fuel4less" />

            <TextView
                android:id="@+id/txtSearchFaker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_mapa_buscador"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#9E9E9E"
                android:layout_toEndOf="@id/imgAppLogoTop"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"/>

            <!-- Icono Filtros -->
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/ic_menu_sort_by_size"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                app:tint="#555555"
                android:contentDescription="@string/cd_mapa_filtros" />

        </RelativeLayout>
    </androidx.cardview.widget.CardView>


    <!-- ============================================== -->
    <!-- 2. EL MAPA CENTRAL                             -->
    <!-- ============================================== -->
    <!-- El mapa ahora solo devorará el espacio "sobrante" entre la barra superior y la inferior -->
    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/topBarFiltros"
        app:layout_constraintBottom_toTopOf="@id/bottomNavPlaceholder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <!-- ============================================== -->
    <!-- 3. BOTÓN MI UBICACIÓN                          -->
    <!-- ============================================== -->
    <!-- Lo anclamos exactamente a la fina línea inferior del mapa para que jamás pise otras cosas -->
    <!-- FAB de ruta: abre RutaActivity para calcular una ruta con gasolineras -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnRuta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="185dp"
        android:src="@android:drawable/ic_menu_directions"
        app:backgroundTint="#1565C0"
        app:tint="#FFFFFF"
        app:elevation="6dp"
        android:contentDescription="@string/cd_mapa_btn_ruta"
        app:layout_constraintBottom_toBottomOf="@id/map"
        app:layout_constraintEnd_toEndOf="@id/map" />

    <!-- FAB de ubicación: centra la cámara en la posición actual -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnMiUbicacion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="120dp"
        android:src="@android:drawable/ic_menu_mylocation"
        app:backgroundTint="#FFFFFF"
        app:tint="#1976D2"
        app:elevation="6dp"
        android:contentDescription="@string/cd_mapa_btn_ubicacion"
        app:layout_constraintBottom_toBottomOf="@id/map"
        app:layout_constraintEnd_toEndOf="@id/map" />


    <!-- ============================================== -->
    <!-- 4. HUECO PARA FUTURA BARRA INFERIOR DE NAV    -->
    <!-- ============================================== -->
    <FrameLayout
        android:id="@+id/bottomNavPlaceholder"
        android:layout_width="0dp"
        android:layout_height="100dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="#EEEEEE">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/text_mapa_menu_inferior"
            android:textStyle="bold"
            android:textColor="#555555"
            android:gravity="center"
            android:lineSpacingExtra="4dp" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>