<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F8">

    <!-- Panel superior con los campos de texto y botones -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardRutaPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:cardElevation="6dp"
        app:cardCornerRadius="0dp"
        app:cardBackgroundColor="@android:color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="12dp">

            <!-- Titulo -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/text_ruta_titulo"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#1A237E"
                android:layout_marginBottom="12dp"/>

            <!-- Campo de origen con autocompletado -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilOrigen"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_ruta_origen"
                android:layout_marginBottom="10dp"
                android:minHeight="62dp"
                app:boxStrokeColor="#1565C0"
                app:hintTextColor="#1565C0"
                app:endIconMode="custom"
                app:endIconDrawable="@android:drawable/ic_menu_mylocation"
                app:endIconTint="#1565C0">

                <!--
                    AutoCompleteTextView en lugar de TextInputEditText:
                    muestra sugerencias de municipios mientras el usuario escribe.
                    El adapter se rellena desde el ViewModel una vez que carguen las gasolineras.
                -->
                <AutoCompleteTextView
                    android:id="@+id/etOrigen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:imeOptions="actionNext"
                    android:singleLine="true"
                    android:textSize="15sp"
                    android:completionThreshold="2"
                    android:dropDownHeight="200dp"/>

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Campo de destino con autocompletado -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDestino"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_ruta_destino"
                android:layout_marginBottom="12dp"
                android:minHeight="62dp"
                app:boxStrokeColor="#C62828"
                app:hintTextColor="#C62828">

                <AutoCompleteTextView
                    android:id="@+id/etDestino"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:imeOptions="actionDone"
                    android:singleLine="true"
                    android:textSize="15sp"
                    android:completionThreshold="2"
                    android:dropDownHeight="200dp"/>

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Botones -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btnCalcularRuta"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="2"
                    android:text="@string/text_ruta_btn_calcular"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:backgroundTint="#1565C0"
                    android:textColor="@android:color/white"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/btnLimpiarRuta"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/text_ruta_btn_limpiar"
                    android:textSize="13sp"
                    android:backgroundTint="#78909C"
                    android:textColor="@android:color/white"/>

            </LinearLayout>

            <!-- Texto de estado: resultado o error -->
            <TextView
                android:id="@+id/txtRutaEstado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="13sp"
                android:textColor="#555555"
                android:gravity="center"
                android:visibility="gone"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Mapa: ocupa todo el espacio restante -->
    <fragment
        android:id="@+id/mapRuta"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/cardRutaPanel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Spinner de carga centrado sobre el mapa -->
    <ProgressBar
        android:id="@+id/progressRuta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/cardRutaPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
